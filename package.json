{
  "name": "mp3-cutter",
  "version": "1.0.0",
  "description": "Studio Audio Cutter - แอปตัดต่อไฟล์เสียง MP3",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "author": "TEXAS INTECH Innovation & Technology ลุงแจ่ม อารมณ์ดี",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0"
  },
  "build": {
    "appId": "com.aromdee2012.mp3cutter",
    "productName": "Studio Audio Cutter",
    "publish": "never",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "shortcutName": "Studio Audio Cutter"
    }
  }
}
